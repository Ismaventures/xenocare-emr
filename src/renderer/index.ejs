<!DOCTYPE html>
<html>
  <head>
    <%
      const isDevelopment = process.env.NODE_ENV !== 'production';
      // Electron desktop app: allow http/https/ws/wss for connect-src in all modes.
      // The Supabase URL is admin-configured and may use plain HTTP on LAN.
      const contentSecurityPolicy = isDevelopment
        ? "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: https: http:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: http: ws: wss:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self' data:;"
        : "default-src 'self'; script-src 'self'; connect-src 'self' https: http: ws: wss:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';";
    %>
    <meta charset="utf-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="<%= contentSecurityPolicy %>"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 112 112'%3E%3Crect x='5' y='5' width='102' height='102' rx='27' fill='%230E2A47'/%3E%3Cpath d='M29 29L83 83M83 29L29 83' fill='none' stroke='%23FFFFFF' stroke-width='9' stroke-linecap='round'/%3E%3Cpath d='M51 40H61V51H72V61H61V72H51V61H40V51H51V40Z' fill='%23F97316' stroke='%23FFFFFF' stroke-width='1.5' stroke-linejoin='round'/%3E%3C/svg%3E"
    />
    <title>XenoCare EMR</title>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
