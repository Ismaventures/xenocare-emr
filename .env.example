SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DEBUG_PROD=false
START_MINIMIZED=false
UPGRADE_EXTENSIONS=false
ICD_CLIENT_ID=replace-with-icd-client-id
ICD_CLIENT_SECRET=replace-with-icd-client-secret
ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
ICD_API_BASE=https://id.who.int/icd/release/10/2010

# AI Clinical Assistant Configuration
AI_PROVIDER=ollama

# Groq
GROQ_API_KEY=replace-with-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=gemma4:31b-cloud
OLLAMA_NUM_CTX=8192
OLLAMA_CHAT_MAX_TOKENS=768
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768

# Google Gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
